<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net452</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>AndroidToolkitPro</AssemblyName>
    <RootNamespace>AndroidToolkitPro</RootNamespace>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <Platforms>AnyCPU;x64</Platforms>
    
    <!-- 👇 ESTAS DOS LÍNEAS SON CLAVE PARA QUE FUNCIONE EL FASTBOOT DE 64 BITS -->
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <!-- ⚠️ IMPORTANTE: Copia las carpetas manteniendo su estructura original -->
  <ItemGroup>
    <!-- Copiar Scrcpy -->
    <Content Include="Tools\Scrcpy\**\*.*">
      <Link>Tools\Scrcpy\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    
    <!-- Copiar PlatformTools (Tu nuevo ADB) -->
    <Content Include="Tools\PlatformTools\**\*.*">
      <Link>Tools\PlatformTools\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
